FROM rust:1.94-slim

LABEL description="AetherArch CI test environment"

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    pkg-config \
    libssl-dev \
    libclang-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install additional Rust toolchain components
RUN rustup component add clippy rustfmt

# Create workspace directory
WORKDIR /workspace

# Copy entire project
COPY . .

# Build cache - this layer can be reused across runs
RUN cargo fetch

# Run all CI checks.
# NOTE: This MUST be a single-line JSON array (exec form). A multi-line
# string with backslash continuations is invalid JSON, so Docker silently
# falls back to shell form and /bin/sh fails with "Unterminated quoted
# string". Keep the whole pipeline on one line.
CMD ["/bin/bash", "-c", "set -e && echo '====== BUILD TEST ======' && cargo build --workspace --release && echo '====== TEST SUITE ======' && cargo test --workspace --release && echo '====== CLIPPY ======' && cargo clippy --workspace -- -D warnings && echo '====== FORMAT CHECK ======' && cargo fmt --all -- --check && echo '====== DOCUMENTATION ======' && cargo doc --workspace --no-deps && echo '====== MSRV CHECK (1.88.0) ======' && rustup install 1.88.0 && cargo +1.88.0 check --workspace && echo '====== ALL TESTS PASSED ======'"]
